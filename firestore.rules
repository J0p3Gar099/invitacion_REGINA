rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // RSVPs: cualquiera puede crear, nadie puede leer en público
    match /rsvps/{id} {
      allow create: if request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.attending is bool;
      allow read, update, delete: if false; // solo admin via Firebase Console
    }

    // Mensajes: cualquiera crea, solo se leen los aprobados
    match /messages/{id} {
      allow create: if request.resource.data.author is string
                    && request.resource.data.text is string
                    && request.resource.data.text.size() < 500;
      allow read: if resource.data.approved == true;
      allow update, delete: if false; // solo admin via Firebase Console
    }

    // Regalos: cualquiera puede reclamar/liberar
    match /gifts/{id} {
      allow read, write: if true;
    }

    // Bebidas: cualquiera puede votar
    match /drinks/{id} {
      allow read, create: if request.resource.data.drinkId is string
                          && request.resource.data.voterName is string;
      allow update, delete: if false;
    }
  }
}
